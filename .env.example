# ============================================================
# PlanetCode — Environment Variables
# Reference: Master Prompt §18
#
# INSTRUCTIONS:
# 1. Copy this file to .env (or .env.local for Next.js)
# 2. Fill in the values
# 3. NEVER commit .env files with real values
# ============================================================

# --- Clerk Authentication ---
# Browser-safe (public): Clerk publishable key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server-only (secret): Clerk secret key — NEVER expose to client
CLERK_SECRET_KEY=

# --- Database ---
# Server-only: PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# --- Realtime Server ---
# Browser-safe (public): WebSocket server URL
# Local: ws://localhost:3001 | Production: wss://your-realtime.onrender.com
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3001

# --- Redis (OPTIONAL — only when scaling to multiple realtime servers) ---
# Server-only: Redis/Upstash connection string
# REDIS_URL=

# --- Monitoring ---
# Server-only: Sentry DSN for error reporting
# SENTRY_DSN=
