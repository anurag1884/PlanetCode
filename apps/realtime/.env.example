# ============================================================
# PlanetCode Realtime Server — Environment Variables
# Copy to .env and fill in values
# ============================================================

# Server port
PORT=3001

# Database (server-only)
DATABASE_URL=

# Clerk (server-only — for verifying session tokens on WS handshake)
CLERK_SECRET_KEY=

# Redis (OPTIONAL — only when scaling to multiple realtime instances)
# REDIS_URL=

# Sentry (server-only)
# SENTRY_DSN=

# CORS — allowed origin for WebSocket connections
ALLOWED_ORIGIN=http://localhost:3000
