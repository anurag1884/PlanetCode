# ============================================================
# PlanetCode Web App — Environment Variables
# Copy to .env.local and fill in values
# ============================================================

# Clerk (public — safe for browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk (secret — server-only)
CLERK_SECRET_KEY=

# Database (server-only)
DATABASE_URL=

# Realtime server URL (public — browser connects to this)
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3001

# Sentry (server-only)
# SENTRY_DSN=
